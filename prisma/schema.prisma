  // Use Unsupported("vector")? so Prisma will accept the DB type while allowing raw SQL operations.
  // embedding Unsupported("vector")? // pgvector extension not enabled in local DB
  embeddingJson Json? @map("embedding_json")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([path])
  @@map("knowledge_nodes")
}

