# Production Environment Configuration for Azora Buildspaces

# Database Configuration
DATABASE_URL="postgresql://buildspaces_user:${POSTGRES_PASSWORD}@postgres:5432/buildspaces_prod?schema=public"
DIRECT_URL="postgresql://buildspaces_user:${POSTGRES_PASSWORD}@postgres:5432/buildspaces_prod?schema=public"

# Redis Configuration
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379"
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD="${REDIS_PASSWORD}"

# Application Configuration
NODE_ENV="production"
PORT="3000"
HOST="0.0.0.0"

# Security Configuration
JWT_SECRET="${JWT_SECRET}"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="${SESSION_SECRET}"
ENCRYPTION_KEY="${ENCRYPTION_KEY}"

# API Configuration
API_BASE_URL="https://api.azora.world"
NEXT_PUBLIC_API_BASE_URL="https://api.azora.world"

# WebSocket Configuration
NEXT_PUBLIC_YJS_WEBSOCKET_URL="wss://ws.azora.world"
YJS_WEBSOCKET_URL="wss://ws.azora.world"

# AI Configuration
ELARA_API_URL="https://ai.azora.sapiens"
ELARA_API_KEY="${ELARA_API_KEY}"
AI_FAMILY_API_URL="https://ai-family.azora.sapiens"

# Constitutional AI Configuration
CONSTITUTIONAL_AI_ENABLED="true"
CONSTITUTIONAL_AI_ENDPOINT="https://constitutional-ai.azora.sapiens"
CONSTITUTIONAL_COMPLIANCE_THRESHOLD="95"

# Monitoring and Logging
SENTRY_DSN="${SENTRY_DSN}"
LOG_LEVEL="info"
ENABLE_METRICS="true"

# Storage Configuration
AWS_S3_BUCKET="${AWS_S3_BUCKET}"
AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID}"
AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY}"
AWS_REGION="us-east-1"

# Email Configuration
SMTP_HOST="${SMTP_HOST}"
SMTP_PORT="587"
SMTP_USER="${SMTP_USER}"
SMTP_PASSWORD="${SMTP_PASSWORD}"
FROM_EMAIL="noreply@azora.world"

# Feature Flags
ENABLE_COLLABORATION="true"
ENABLE_AI_MODEL_DEVELOPMENT="true"
ENABLE_REAL_TIME_COMMUNICATION="true"
ENABLE_PERFORMANCE_MONITORING="true"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# CORS Configuration
CORS_ORIGIN="https://buildspaces.azora.world"

# Build Configuration
NEXT_TELEMETRY_DISABLED="1"
GENERATE_SOURCEMAP="false"
