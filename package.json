{
  "name": "azora",
  "version": "1.0.0",
  "scripts": {
    "playwright:install": "npx playwright install --with-deps",
    "test:e2e": "npx playwright test",
    "test:e2e:ci": "npx playwright test --reporter=github --workers=2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.21.5"
    }
  },
  "prepare": "npm run hooks:install",
  "devDependencies": {
    "@babel/preset-env": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@playwright/test": "^1.57.0",
    "@types/jest": "30.0.0",
    "babel-jest": "30.2.0",
    "husky": "8.0.3",
    "jest": "30.2.0",
    "rimraf": "^5.0.0",
    "ts-jest": "29.4.5",
    "turbo": "^1.6.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "7.2.0",
    "next-auth": "4.24.13"
  }
}
